# Voxsy backend — same variable names as the reference project.
# In this workspace the values are read from the project root .env; every one of them has a default.

STATUS=DEV

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/
MONGO_DATABASE_NAME=voxsy
# When MONGO_URI points at this machine and nothing is listening there, the backend downloads the
# official mongod build once and runs it itself. Set to false if you run MongoDB yourself.
MONGO_AUTOSTART=true
# MONGO_DATA_DIR=/home/you/.voxsy/mongodb

# Mock accounts and sample chats (src/mocks/data.mock.ts). Defaults to true unless STATUS=PROD.
SEED_MOCK_DATA=true

# Files
MAX_MB_UPLOAD_SIZE=15
